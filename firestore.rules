rules_version = '2';
// Security rules for Rohit's portfolio: visitor diary, ratings, views and the private insights page.
// Paste into Firebase console > Firestore Database > Rules, then click Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'rparjane@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // One summary document: total views, views per day, diary count, rating totals, resume downloads and social/contact clicks.
    match /stats/main {
      allow read: if true;

      // First visitor, signature, download or click creates it with starting values only.
      allow create: if isOwner() || (
        request.resource.data.keys().hasOnly(['views', 'days', 'count', 'ratingCount', 'ratingSum', 'downloads', 'dlDays', 'clk_linkedin', 'clk_figma', 'clk_instagram', 'clk_mail', 'clk_whatsapp', 'clk_call', 'clk_mh', 'clk_sr', 'clk_bd', 'clk_oe'])
        && request.resource.data.get('views', 0) <= 1
        && request.resource.data.get('count', 0) <= 1
        && request.resource.data.get('ratingCount', 0) <= 1
        && request.resource.data.get('ratingSum', 0) <= 5
        && request.resource.data.get('downloads', 0) <= 1
        && request.resource.data.get('clk_linkedin', 0) <= 1 && request.resource.data.get('clk_figma', 0) <= 1
        && request.resource.data.get('clk_instagram', 0) <= 1 && request.resource.data.get('clk_mail', 0) <= 1
        && request.resource.data.get('clk_whatsapp', 0) <= 1 && request.resource.data.get('clk_call', 0) <= 1
        && request.resource.data.get('clk_mh', 0) <= 1 && request.resource.data.get('clk_sr', 0) <= 1 && request.resource.data.get('clk_bd', 0) <= 1 && request.resource.data.get('clk_oe', 0) <= 1
      );

      allow update: if isOwner() || isOneView() || isOneSignature() || isOneDownload() || isOneClick();

      // A visit may only add exactly one view.
      function isOneView() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'days'])
          && request.resource.data.views == resource.data.get('views', 0) + 1;
      }

      // A signature may only add one entry and one rating of 1 to 5 stars.
      function isOneSignature() {
        let added = request.resource.data.ratingSum - resource.data.get('ratingSum', 0);
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'ratingCount', 'ratingSum'])
          && request.resource.data.count == resource.data.get('count', 0) + 1
          && request.resource.data.ratingCount == resource.data.get('ratingCount', 0) + 1
          && added >= 1 && added <= 5;
      }

      // A resume download may only add exactly one download.
      function isOneDownload() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloads', 'dlDays'])
          && request.resource.data.downloads == resource.data.get('downloads', 0) + 1;
      }

      // A social/contact link or game card click may only add exactly one to a single channel.
      function isOneClick() {
        let ks = request.resource.data.diff(resource.data).affectedKeys();
        let k = ks.toList()[0];
        return ks.size() == 1
          && ks.hasOnly(['clk_linkedin', 'clk_figma', 'clk_instagram', 'clk_mail', 'clk_whatsapp', 'clk_call', 'clk_mh', 'clk_sr', 'clk_bd', 'clk_oe'])
          && request.resource.data[k] == resource.data.get(k, 0) + 1;
      }
    }

    // Anonymous visit analytics: one document per visit with section time and approximate location.
    // Visitors can only create their own visit and add time to it for a few hours; only Rohit can read.
    match /visits/{visitId} {
      function validSec(m) {
        return m is map && m.keys().hasOnly(['home', 'work', 'case1', 'case2', 'about', 'play', 'resume', 'contact']) && (!('home' in m) || (m.home is int && m.home >= 0 && m.home <= 10800)) && (!('work' in m) || (m.work is int && m.work >= 0 && m.work <= 10800)) && (!('case1' in m) || (m.case1 is int && m.case1 >= 0 && m.case1 <= 10800)) && (!('case2' in m) || (m.case2 is int && m.case2 >= 0 && m.case2 <= 10800)) && (!('about' in m) || (m.about is int && m.about >= 0 && m.about <= 10800)) && (!('play' in m) || (m.play is int && m.play >= 0 && m.play <= 10800)) && (!('resume' in m) || (m.resume is int && m.resume >= 0 && m.resume <= 10800)) && (!('contact' in m) || (m.contact is int && m.contact >= 0 && m.contact <= 10800));
      }
      allow read, delete: if isOwner();
      allow create: if request.resource.data.keys().hasOnly(['at', 'country', 'region', 'city', 'dev', 'sec'])
        && request.resource.data.at == request.time
        && request.resource.data.country is string && request.resource.data.country.size() <= 2
        && request.resource.data.region is string && request.resource.data.region.size() <= 40
        && request.resource.data.city is string && request.resource.data.city.size() <= 60
        && request.resource.data.dev in ['mobile', 'desktop']
        && validSec(request.resource.data.sec) && request.resource.data.sec.size() == 0;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sec'])
        && validSec(request.resource.data.sec)
        && request.time < resource.data.at + duration.value(4, 'h');
    }

    // Diary entries: anyone can read and add a valid one; only Rohit can edit (name/note) or delete.
    match /entries/{entryId} {
      allow read: if true;
      allow create: if
        request.resource.data.keys().hasOnly(['no', 'name', 'rating', 'note', 'at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 40
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.note is string && request.resource.data.note.size() <= 300
        && request.resource.data.no is int
        && request.resource.data.no == getAfter(/databases/$(database)/documents/stats/main).data.count
        && request.resource.data.at == request.time;
      // Only Rohit can fix a typo in a name or note; number, rating and date stay as signed.
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'note'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 40
        && request.resource.data.note is string && request.resource.data.note.size() <= 300;
      allow delete: if isOwner();
    }
  }
}
